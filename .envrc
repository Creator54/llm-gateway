use flake
socket="${XDG_RUNTIME_DIR:?}/podman/podman.sock"
if ! curl --silent --fail --max-time 1 --unix-socket "$socket" http://localhost/_ping >/dev/null 2>&1; then
  systemd-run --user --quiet --collect --unit=llm-gateway-podman \
    "$(command -v podman)" system service --time=0 "unix://$socket" || return 1
  for _ in {1..30}; do
    curl --silent --fail --max-time 1 --unix-socket "$socket" http://localhost/_ping >/dev/null 2>&1 && break
    sleep 0.1
  done
  if ! curl --silent --fail --max-time 1 --unix-socket "$socket" http://localhost/_ping >/dev/null 2>&1; then
    echo 'Podman API failed to start; run journalctl --user -u llm-gateway-podman' >&2
    return 1
  fi
fi
just --quiet info
